# وب‌اپلیکیشن Next.js — apps/web

## GraphQL
# آدرس endpoint بک‌اند (همان‌طور که از بیرون دیده می‌شود)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://ecommerce-zariny.vercel.app/dashboard/graphql/
# مسیری که rewrite داخلی روی آن سرو می‌کند (same-origin برای کلاینت)
GRAPHQL_PROXY_PATH=/api/graphql

## اعتبارنامه‌ها — فقط برای توسعه‌ی لوکال، هرگز کامیت نشود
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
