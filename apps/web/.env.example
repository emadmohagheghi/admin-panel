# وب‌اپلیکیشن Next.js — apps/web

## GraphQL
# آدرس endpoint بک‌اند — فقط سمت سرور (Route Handler پروکسی) استفاده می‌شود
# و به کلاینت لو نمی‌رود (بدون NEXT_PUBLIC_)
GRAPHQL_BACKEND_ENDPOINT=https://193.228.90.241:7777/dashboard/graphql/
# مسیر پروکسی same-origin (Route Handler در app/api/graphql)
GRAPHQL_PROXY_PATH=/api/graphql
# موقت تا وقتی بک‌اند گواهی TLS معتبر بگیرد: با 1 یا true، بررسی گواهی
# self-signed بک‌اند فقط برای fetchهای داخل Route Handler پروکسی رد می‌شود.
# ریسک MITM بین Vercel و بک‌اند — بعد از گواهی معتبر حذف شود.
GRAPHQL_ALLOW_INSECURE_TLS=

## احراز هویت JWT با کوکی
# کوکی access token — گیت proxy.ts با آن تصمیم می‌گیرد کاربر لاگین است یا نه
SESSION_COOKIE_NAME=access
# کوکی‌های دیگر مجاز برای ارسال به بک‌اند (refresh و...) — جدا با کاما
SESSION_COOKIE_NAMES=refresh

## اعتبارنامه‌ها — فقط برای توسعه‌ی لوکال، هرگز کامیت نشود
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
